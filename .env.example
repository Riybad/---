# كلمة مرور الدخول للوحة التحكم (غيّرها قبل التشغيل الفعلي)
ADMIN_PASSWORD=admin123

# قاعدة البيانات السحابية (Neon/أي Postgres) — اتركه فارغًا للتشغيل المحلي
# على Vercel: يُضاف تلقائيًا عند ربط قاعدة Neon من تبويب Storage
# DATABASE_URL=

# تخزين ملفات الفواتير السحابي (Vercel Blob) — يُضاف تلقائيًا عند إنشاء Blob store
# BLOB_READ_WRITE_TOKEN=

# مفتاح توقيع الجلسات (اختياري — يُشتق تلقائيًا من كلمة المرور إن لم يوجد)
# AUTH_SECRET=
